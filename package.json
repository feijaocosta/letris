{
  "name": "letris-game",
  "version": "1.0.0",
  "description": "LETRIS - Jogo que mistura Tetris com caça-palavras, em português, inglês, espanhol e francês",
  "main": "index.js",
  "homepage": "https://letris.kingdomapps.net",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-words.mjs && node scripts/check-locales.mjs && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "build:e2e": "node scripts/check-words.mjs && node scripts/check-locales.mjs && LETRIS_E2E=1 vite build --outDir dist-e2e",
    "test": "playwright test --project=logica --project=chromium",
    "test:safari": "playwright test --project=safari",
    "test:ui": "playwright test --ui --project=logica --project=chromium",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@radix-ui/react-slot": "1.1.2",
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.0.3"
  },
  "keywords": [
    "tetris",
    "palavras",
    "caça-palavras",
    "word game",
    "jogo",
    "pwa",
    "react",
    "typescript"
  ],
  "author": "Kingdom Apps",
  "license": "MIT"
}
